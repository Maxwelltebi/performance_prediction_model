{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "functions": {
    "server.py": {
      "maxDuration": 120,
      "includeFiles": "models/*.joblib",
      "excludeFiles": "{venv/**,.venv*/**,.deployment-check/**,.hf-release/**,deploy/**,backend/test_*.py,main.py,*.ipynb,tests/**}"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
